<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISOS: antes de agregar uno, debe estar en la tabla de permisos de
        docs/06-guardrails.md (para qué sirve, en qué fase y cómo se pide).
        El esqueleto actual no necesita ninguno.
    -->

    <!-- allowBackup=false: los datos emocionales no se suben al backup de Google (ADR-0002). -->
    <application
        android:name=".PanbuApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Panbu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Panbu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
